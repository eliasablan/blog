---
import type { CollectionEntry } from "astro:content";
import type { Lang } from "@/i18n/ui";
import { splitEntryId, useTranslations } from "@/i18n/utils";
import { sectionPath } from "@/i18n/routes";
import { tagLabels, tagPath } from "@/i18n/tags";
import { kindLabelsSingular } from "@/i18n/kinds";
import Button from "@/components/starwind/Button.astro";
import Card from "@/components/starwind/Card.astro";

interface Props {
  project: CollectionEntry<"portfolio">;
  lang: Lang;
  /** "row" spans the column (lists); "tile" is one cell of a grid. */
  form?: "row" | "tile";
}

const { project, lang, form = "row" } = Astro.props;
const t = useTranslations(lang);
const { slug } = splitEntryId(project.id);
const href = `${sectionPath(lang, "projects")}/${slug}`;
const key = project.data.translationKey;
const { kind, demo, repo, tags } = project.data;
const tile = form === "tile";
---

<Card class="pcard relative flex h-full flex-col">
  <div
    class="pcard-head dith-bar h-[calc(var(--cell)*2)] gap-3 pl-3 font-mono text-[11px] font-bold tracking-[0.08em] whitespace-nowrap uppercase [--dith-w:calc(var(--px)*12)]"
  >
    <span>
      <span class="font-normal opacity-70" aria-hidden="true">//</span>
      {kindLabelsSingular[kind][lang]}
    </span>
    <span class="ml-auto font-normal" transition:name={`project-${key}-year`}>
      {project.data.year}
    </span>
    <span class="dith" aria-hidden="true"></span>
  </div>

  <div
    class:list={[
      "flex flex-1 gap-4 p-4",
      tile
        ? "flex-col"
        : "flex-row items-start gap-6 max-[600px]:flex-col max-[600px]:gap-4",
    ]}
  >
    <div class="flex min-w-0 flex-1 flex-col gap-1.5">
      <a
        href={href}
        class:list={[
          "pcard-link font-serif leading-tight font-semibold text-foreground no-underline decoration-foreground/40 underline-offset-4",
          tile ? "text-[19px]" : "text-[22px] tracking-[-0.008em]",
        ]}
      >
        <span transition:name={`project-${key}-title`}
          >{project.data.title}</span
        >
      </a>
      <p class="m-0 max-w-[56ch] text-base leading-normal text-tx-secondary">
        <span transition:name={`project-${key}-description`}
          >{project.data.description}</span
        >
      </p>
      {
        tags.length > 0 && (
          <p class="m-0 mt-1 font-mono text-xs leading-normal text-tx-muted">
            {tags.map((tag, i) => (
              <>
                <a
                  href={tagPath(lang, tag)}
                  class="pcard-tag relative z-2 text-inherit"
                  set:text={tagLabels[tag][lang]}
                />
                {i < tags.length - 1 && (
                  <span class="mx-1.5 opacity-70" aria-hidden="true">
                    ·
                  </span>
                )}
              </>
            ))}
          </p>
        )
      }
    </div>

    {
      (demo || repo) && (
        <div
          class:list={[
            "flex gap-2",
            tile ? "mt-auto pt-1" : "flex-col max-[600px]:flex-row",
          ]}
        >
          {demo && (
            <Button
              href={demo}
              variant="outline"
              size="sm"
              class="relative z-2 gap-1.5"
            >
              <svg
                viewBox="0 0 16 16"
                aria-hidden="true"
                class="block h-3 w-3 fill-none stroke-current stroke-[1.5]"
              >
                <path
                  d="M5 11L11 5M11 5H6.5M11 5V9.5"
                  stroke-linecap="square"
                />
              </svg>
              {t("projects.demo.short")}
            </Button>
          )}
          {repo && (
            <Button
              href={repo}
              variant="outline"
              size="sm"
              class="relative z-2 gap-1.5"
            >
              <svg
                viewBox="0 0 16 16"
                aria-hidden="true"
                class="block h-3 w-3 fill-none stroke-current stroke-[1.5]"
              >
                <path
                  d="M5.5 5L2.5 8L5.5 11M10.5 5L13.5 8L10.5 11M9.5 4L6.5 12"
                  stroke-linecap="square"
                />
              </svg>
              {t("projects.repo.short")}
            </Button>
          )}
        </div>
      )
    }
  </div>
</Card>

<style>
  /* The whole card opens the Project: the title link stretches over it,
     and the tag and demo/repo links sit above that layer. The layer needs a
     z-index: the description and year carry a view-transition-name, which
     makes them stacking contexts that would paint over it. */
  .pcard {
    transition:
      background-color var(--dur-hover) ease-out,
      opacity var(--dur-press) var(--ease-out),
      transform var(--dur-press) var(--ease-out);
  }
  .pcard-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* One ring, on the card, when the title link has keyboard focus. */
  .pcard-link:focus-visible {
    outline: none;
    text-decoration-line: underline;
  }
  .pcard:has(.pcard-link:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  /* Press: a third of the shared press scale, a whole card at 0.97 jumps.
     Only the title link presses the card; tags and buttons press themselves.
     Reduced motion sets --press-scale to 1, so this becomes a dim. */
  .pcard:has(.pcard-link:active) {
    transform: scale(calc(1 - (1 - var(--press-scale)) / 3));
    opacity: var(--press-opacity);
  }

  .pcard-tag {
    text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
  }

  /* Hover over the card (not its tag or demo/repo links): it tints like a
     Card with hover, the header ink advances one cell into the ramp, as
     every dith-bar link does, and the title underlines. */
  @media (hover: hover) and (pointer: fine) {
    .pcard:has(.pcard-link:hover) {
      background-color: var(--bg-secondary);
    }
    .pcard:has(.pcard-link:hover) .pcard-head {
      background-size: calc(100% - var(--dith-w) + var(--cell)) 100%;
    }
    .pcard:has(.pcard-link:hover) .pcard-link {
      text-decoration-line: underline;
    }
    .pcard-tag:hover {
      color: var(--ink);
      text-decoration-color: var(--ink);
    }
  }
</style>
