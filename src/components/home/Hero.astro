---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { sectionPath } from "@/i18n/routes";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Stair silhouette: width of each row in units; a dithered cap hangs off
// its right edge.
const stairs = [3, 3, 3, 5, 5, 7, 7, 7, 9, 9, 6, 6, 4, 4, 3, 3];
const scope = {
  label: { es: "Alcance", en: "Scope" },
  code: { es: "Código", en: "Code" },
  servers: { es: "Servidores", en: "Servers" },
  networks: { es: "Redes", en: "Networks" },
  hosting: { es: "Hosting", en: "Hosting" },
};
const scopeItems = [scope.code, scope.servers, scope.networks, scope.hosting];
---

<section class="hero">
  <div class="stair" aria-hidden="true">
    {
      stairs.map((n, i) => (
        <span class="step" style={`--n:${n};--i:${i}`}>
          <span class="dith" />
        </span>
      ))
    }
  </div>

  <div
    class="col font-mono text-[13px] leading-normal tracking-[0.02em] text-foreground uppercase"
  >
    <div
      class="boxhead rise grid-cols-[auto_1fr] text-xs font-bold tracking-[0.08em]"
      style="--i:0"
    >
      <span class="font-normal" aria-hidden="true">//01</span>
      <p class="box-fill m-0 leading-[1.25]">{t("home.hero.eyebrow")}</p>
    </div>

    <h1 class="rise mt-9 mb-0 font-normal" style="--i:1">
      <span
        class="block font-pixel text-[clamp(26px,3.5vw,42px)] leading-[1.12] font-bold tracking-[0.01em] text-balance"
        >{t("home.hero.head")}</span
      >{" "}
      <span
        class="mt-4.5 block max-w-[34em] text-[12.5px] leading-[1.65] tracking-[0.05em] text-tx-muted"
        >{t("home.hero.tail")}</span
      >
    </h1>

    <div
      class="rise mt-10 flex items-start justify-between gap-6 text-xs tracking-[0.06em]"
      style="--i:2"
    >
      <ul class="m-0 list-none p-0 leading-[1.7]">
        <li class="text-tx-muted" aria-hidden="true">
          //{scope.label[lang]}
        </li>
        {scopeItems.map((s) => <li>{s[lang]}</li>)}
      </ul>
      <div class="checker" aria-hidden="true"></div>
    </div>

    <div class="rule-dots rise mt-7" style="--i:3" aria-hidden="true"></div>
    <p class="rise mt-2.5 mb-0 text-xs tracking-[0.06em]" style="--i:3">
      Caracas, Venezuela
    </p>

    <div class="rise mt-7" style="--i:4">
      <a
        href={`/${lang}/#contact`}
        class="cta dith-bar h-[calc(var(--cell)*5)] gap-4 pl-6 text-[13px] font-bold tracking-[0.08em]"
      >
        {t("home.hero.cta.contact")}
        <span class="slashes ml-auto pr-1 opacity-60" aria-hidden="true"
          >///</span
        >
        <span class="dith" aria-hidden="true"></span>
      </a>
      <a
        href={sectionPath(lang, "projects")}
        class="quiet mt-4.5 inline-block text-xs tracking-[0.08em] text-foreground decoration-current decoration-dotted underline-offset-[6px]"
        >{t("home.hero.cta.projects")}</a
      >
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) min(100%, 640px) minmax(0, 1fr);
    padding-bottom: 120px;
  }
  .stair {
    --u: clamp(14px, 2vw, 24px);
    display: flex;
    flex-direction: column;
    align-self: start;
    margin-top: clamp(24px, 6vh, 64px);
  }
  .step {
    position: relative;
    display: block;
    /* whole dither cells tall and whole pixels wide, so no row is clipped */
    height: round(calc(var(--u) * 1.6), var(--cell));
    width: round(calc(var(--u) * var(--n)), var(--px));
    background: var(--ink);
    transform-origin: left center;
    animation: grow 280ms cubic-bezier(0.23, 1, 0.32, 1) both;
    animation-delay: calc(var(--i) * 22ms);
  }
  .step .dith {
    position: absolute;
    top: 0;
    left: 100%;
    height: 100%;
  }
  .col {
    grid-column: 2;
    padding: clamp(28px, 7vh, 72px) clamp(20px, 4vw, 40px) 0;
  }
  .cta .slashes {
    transition: opacity 150ms ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .cta:hover .slashes {
      opacity: 1;
    }
    .quiet:hover {
      text-decoration-style: solid;
    }
  }
  /* Leave 264px on each side for the widest step (216px + 48px of dither). */
  @media (width < 1168px) {
    .stair {
      display: none;
    }
  }

  .rise {
    animation: rise 300ms cubic-bezier(0.23, 1, 0.32, 1) both;
    animation-delay: calc(var(--i, 0) * 60ms + 80ms);
  }
  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise,
    .step {
      animation: none;
    }
  }
</style>
