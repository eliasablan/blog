---
import { getCollection } from "astro:content";
import type { Lang } from "@/i18n/ui";
import { filterByLang, useTranslations } from "@/i18n/utils";
import { isPublished, sortPostsByRecent } from "@/lib/content";
import { sectionPath } from "@/i18n/routes";
import PostList from "@/components/PostList.astro";
import Link from "@/components/Link.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = filterByLang(await getCollection("blog"), lang)
  .filter(isPublished)
  .sort(sortPostsByRecent)
  .slice(0, 3);
---

{
  posts.length > 0 && (
    <section class="mx-auto max-w-170 px-8 max-[600px]:px-5">
      <h2 class="mt-16 mb-5 font-serif text-[32px] leading-[1.2] font-semibold tracking-[-0.012em] text-foreground before:mr-3 before:font-normal before:text-primary before:not-italic before:opacity-85 before:content-['§']">
        {t("home.featured.posts.title")}
      </h2>
      <PostList posts={posts} lang={lang} />
      <p class="mt-8 mb-0">
        <Link href={sectionPath(lang, "blog")}>
          {t("home.featured.posts.cta")} →
        </Link>
      </p>
    </section>
  )
}
