---
import { getCollection } from "astro:content";
import type { Lang } from "@/i18n/ui";
import { filterByLang, useTranslations } from "@/i18n/utils";
import { isPublished, sortProjectsByRecent } from "@/lib/content";
import { sectionPath } from "@/i18n/routes";
import ProjectCard from "@/components/ProjectCard.astro";
import Button from "@/components/starwind/Button.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = filterByLang(await getCollection("portfolio"), lang)
  .filter(
    (p) => isPublished(p) && p.data.featured && p.data.kind !== "side-project",
  )
  .sort(sortProjectsByRecent)
  .slice(0, 5);
---

{
  projects.length > 0 && (
    <section class="mx-auto max-w-170 px-8 max-[600px]:px-5">
      <h2 class="mt-16 mb-5 font-serif text-[32px] leading-[1.2] font-semibold tracking-[-0.012em] text-foreground before:mr-3 before:font-normal before:text-primary before:not-italic before:opacity-85 before:content-['§']">
        {t("home.featured.projects.title")}
      </h2>
      <ul class="m-0 flex list-none flex-col gap-4 p-0">
        {projects.map((project) => (
          <li>
            <ProjectCard project={project} lang={lang} />
          </li>
        ))}
      </ul>
      <Button
        href={sectionPath(lang, "projects")}
        class="mt-4 ml-auto flex w-[calc(50%-8px)] max-[600px]:w-full"
      >
        {t("home.featured.projects.cta")}
      </Button>
      <hr class="mt-16 h-px w-full border-0 bg-rule" />
    </section>
  )
}
