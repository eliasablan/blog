---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { sectionPath } from "@/i18n/routes";
import Link from "@/components/Link.astro";
import AboutEs from "@/content/home/about.es.mdx";
import AboutEn from "@/content/home/about.en.mdx";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const Content = lang === "es" ? AboutEs : AboutEn;
---

<section id="about" class="mx-auto mt-16 max-w-170 px-8 max-[600px]:px-5">
  <div class="rule-dots mb-8" aria-hidden="true"></div>
  <div
    class="[&_a]:text-primary [&_em]:italic [&_p]:m-0 [&_p]:mb-6 [&_p]:text-lg [&_p]:leading-[1.7] [&_p]:text-foreground [&_p:last-child]:mb-0 [&_strong]:font-semibold [&_strong]:text-foreground"
  >
    <Content />
  </div>
  <Link href={sectionPath(lang, "about")} class="mt-8 inline-block">
    {t("home.about.cta")} →
  </Link>
</section>
