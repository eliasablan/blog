---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { sectionPath } from "@/i18n/routes";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";

interface Props {
  lang: Lang;
  /** Explicit URL of the translated counterpart (for entry pages). */
  altLangHref?: string;
  /** When false, switcher renders disabled (entry has no translation in target lang). */
  altLangAvailable?: boolean;
}

const { lang, altLangHref, altLangAvailable = true } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: sectionPath(lang, "services"), label: t("nav.services") },
  { href: sectionPath(lang, "projects"), label: t("nav.projects") },
  { href: sectionPath(lang, "blog"), label: t("nav.blog") },
  { href: sectionPath(lang, "about"), label: t("nav.about") },
];
---

<header
  class="grain sticky top-0 z-50 flex flex-wrap items-center gap-x-3 gap-y-3 border-b border-dotted border-ink bg-background px-3 py-4 font-mono text-xs uppercase [view-transition-name:site-header] sm:gap-x-6 sm:px-[clamp(20px,4vw,40px)]"
>
  <a
    href={`/${lang}/`}
    class="boxhead font-pixel text-[13px] leading-none font-bold whitespace-nowrap text-foreground no-underline sm:text-[15px] [&>*]:px-2.5 sm:[&>*]:px-3"
    data-brand-link
  >
    <span class="max-sm:hidden" aria-hidden="true">EA</span>
    <span class="box-fill relative tracking-[0.06em]">
      <span class="invisible">ELIAS ABLAN</span>
      <span
        class="absolute inset-0 flex items-center justify-center"
        data-brand-scramble
        data-brand-text="ELIAS ABLAN">ELIAS ABLAN</span
      >
    </span>
  </a>

  <nav
    class="order-last flex w-full flex-wrap justify-between gap-x-3 gap-y-1 sm:justify-start sm:gap-6 lg:order-none lg:w-auto lg:flex-1 lg:justify-end lg:gap-5.5"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="inline-flex whitespace-nowrap text-foreground no-underline decoration-current decoration-dotted underline-offset-5 [@media(hover:hover)_and_(pointer:fine)]:hover:underline"
        >
          <span class="text-tx-muted" aria-hidden="true">
            //
          </span>
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="ml-auto flex items-stretch gap-2">
    <LanguageSwitcher
      lang={lang}
      altUrl={altLangHref}
      available={altLangAvailable}
    />
    <ThemeToggle lang={lang} />
    <a
      href={`/${lang}/#contact`}
      class="dith-bar h-(--control-h) gap-3 pl-4 font-bold [--dith-w:calc(var(--px)*12)] max-sm:[--dith-w:calc(var(--px)*8)]"
    >
      {t("nav.contact")}
      <span class="dith" aria-hidden="true"></span>
    </a>
  </div>
</header>

<script>
  const CYCLES_PER_LETTER = 3;
  const SHUFFLE_TIME = 35;
  const CHARS = "!@#$%^&*():{};|,.<>/?";

  const scrambleAllowed = window.matchMedia(
    "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
  );

  function wireBrandScramble() {
    document.querySelectorAll("[data-brand-link]").forEach((link) => {
      if (!(link instanceof HTMLElement) || link.dataset.wired === "1") return;
      link.dataset.wired = "1";

      const textEl = link.querySelector("[data-brand-scramble]");
      if (!(textEl instanceof HTMLElement)) return;

      const brandTextEl = textEl;
      const text =
        brandTextEl.dataset.brandText ?? brandTextEl.textContent ?? "";
      let intervalId: number | undefined;

      function stopScramble() {
        if (intervalId) {
          window.clearInterval(intervalId);
          intervalId = undefined;
        }
        brandTextEl.textContent = text;
      }

      function scramble() {
        if (!scrambleAllowed.matches) return;
        stopScramble();

        let pos = 0;
        intervalId = window.setInterval(() => {
          brandTextEl.textContent = text
            .split("")
            .map((_char, index) => {
              if (pos / CYCLES_PER_LETTER > index) return text[index];

              const randomCharIndex = Math.floor(Math.random() * CHARS.length);
              return CHARS[randomCharIndex];
            })
            .join("");

          pos++;

          if (pos >= text.length * CYCLES_PER_LETTER) {
            stopScramble();
          }
        }, SHUFFLE_TIME);
      }

      link.addEventListener("mouseenter", scramble);
      link.addEventListener("mouseleave", stopScramble);
    });
  }

  wireBrandScramble();
  document.addEventListener("astro:page-load", wireBrandScramble);
</script>
