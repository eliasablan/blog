---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** When true, tints the card on hover (for cards that are links). */
  hover?: boolean;
}

const { class: className, hover = false, ...rest } = Astro.props;
---

<div
  class:list={[
    "overflow-hidden border border-ink text-foreground",
    hover &&
      "transition-colors duration-(--dur-hover) ease-out hover:bg-bg-secondary",
    className,
  ]}
  {...rest}
>
  <slot />
</div>
