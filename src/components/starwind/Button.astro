---
import { tv, type VariantProps } from "tailwind-variants";
import type { HTMLAttributes } from "astro/types";

// Built on the Dither primitives in global.css: primary is a .dith-bar
// (solid ink that dissolves into a trailing .dith), the rest are .ctl
// boxes. Heights are whole --cell multiples so the dither never clips.
// States (hover, press, focus, disabled) and motion live in the primitives.
export const button = tv({
  base:
    "inline-flex gap-2 font-mono font-bold tracking-[0.08em] whitespace-nowrap uppercase no-underline select-none " +
    // Keeps hover utilities from firing on a disabled button or link.
    "disabled:pointer-events-none aria-disabled:pointer-events-none",
  variants: {
    variant: {
      primary: "dith-bar",
      secondary: "ctl bg-(--ui-hover) hover:bg-ink hover:text-paper",
      outline: "ctl",
      ghost: "ctl border-transparent",
      destructive:
        "ctl border-error text-error hover:bg-error hover:text-paper",
    },
    size: {
      sm: "h-[calc(var(--cell)*3)] text-[11px] [--dith-w:calc(var(--px)*8)]",
      md: "h-(--control-h) gap-3 text-xs [--dith-w:calc(var(--px)*12)]",
      lg: "h-[calc(var(--cell)*5)] gap-4 text-[13px]",
      icon: "size-(--control-h) justify-center p-0",
    },
  },
  compoundVariants: [
    // The bar has no right padding: the .dith is its right edge.
    { variant: "primary", size: "sm", class: "pl-3" },
    { variant: "primary", size: "md", class: "pl-4" },
    { variant: "primary", size: "lg", class: "pl-6" },
    { variant: "primary", size: "icon", class: "[--dith-w:0px]" },
    {
      variant: ["secondary", "outline", "ghost", "destructive"],
      size: "sm",
      class: "px-3",
    },
    {
      variant: ["secondary", "outline", "ghost", "destructive"],
      size: "md",
      class: "px-4",
    },
    {
      variant: ["secondary", "outline", "ghost", "destructive"],
      size: "lg",
      class: "px-6",
    },
  ],
  defaultVariants: { variant: "primary", size: "md" },
});

type Variants = VariantProps<typeof button>;

type AnchorProps = HTMLAttributes<"a"> & {
  href: string;
  type?: never;
};
type ButtonProps = HTMLAttributes<"button"> & {
  href?: undefined;
  type?: "button" | "submit" | "reset";
};

type Props = Variants & (AnchorProps | ButtonProps);

const {
  variant,
  size,
  class: className,
  href,
  ...rest
} = Astro.props as Props & { class?: string };
const classes = button({ variant, size, class: className });
const withDith = (variant ?? "primary") === "primary" && size !== "icon";

const isExternal = typeof href === "string" && /^https?:\/\//i.test(href);
const externalAttrs = isExternal
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

{
  href ? (
    <a href={href} class={classes} {...externalAttrs} {...rest}>
      <slot />
      {withDith && <span class="dith ml-auto" aria-hidden="true" />}
    </a>
  ) : (
    <button class={classes} {...rest}>
      <slot />
      {withDith && <span class="dith ml-auto" aria-hidden="true" />}
    </button>
  )
}
