---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"textarea"> {}

const { class: className, ...rest } = Astro.props;
// A <slot /> inside <textarea> is raw text, so render it as the initial value.
const value = Astro.slots.has("default")
  ? await Astro.slots.render("default")
  : undefined;
---

<textarea class:list={["field", className]} {...rest} set:html={value} />
