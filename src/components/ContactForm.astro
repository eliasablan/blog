---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { whatsappUrl } from "@/lib/contact";
import Button from "@/components/starwind/Button.astro";
import Input from "@/components/starwind/Input.astro";
import Label from "@/components/starwind/Label.astro";
import Textarea from "@/components/starwind/Textarea.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<form id="contact-form" novalidate data-lang={lang}>
  {/* Disabled as a whole while sending. */}
  <fieldset class="grid grid-cols-1 gap-x-6 gap-y-2 sm:grid-cols-2">
    <div class="group">
      <Label for="contact-name">
        {t("contact.form.name")}<span aria-hidden="true">*</span>
      </Label>
      <Input
        id="contact-name"
        name="name"
        type="text"
        required
        autocomplete="name"
        autocapitalize="words"
        aria-describedby="contact-name-error"
        placeholder={t("contact.form.namePlaceholder")}
      />
      <p id="contact-name-error" class="error" data-error-for="name"></p>
    </div>
    <div class="group">
      <Label for="contact-email">
        {t("contact.form.email")}<span aria-hidden="true">*</span>
      </Label>
      <Input
        id="contact-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        aria-describedby="contact-email-error"
        placeholder={t("contact.form.emailPlaceholder")}
      />
      <p id="contact-email-error" class="error" data-error-for="email"></p>
    </div>
    <div class="group sm:col-span-2">
      <Label for="contact-subject">{t("contact.form.subject")}</Label>
      <Input
        id="contact-subject"
        name="subject"
        type="text"
        placeholder={t("contact.form.subjectPlaceholder")}
      />
      <p class="error" aria-hidden="true"></p>
    </div>
    <div class="group sm:col-span-2">
      <Label for="contact-message">
        {t("contact.form.message")}<span aria-hidden="true">*</span>
      </Label>
      <Textarea
        id="contact-message"
        name="message"
        required
        rows="6"
        minlength="10"
        aria-describedby="contact-message-error"
        placeholder={t("contact.form.messagePlaceholder")}
      />
      <p id="contact-message-error" class="error" data-error-for="message"></p>
    </div>

    {/* Honeypot */}
    <div
      aria-hidden="true"
      class="absolute -left-2499.75 h-0 w-0 overflow-hidden"
      tabindex="-1"
    >
      <label>
        Website (do not fill)
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <Button
      type="submit"
      size="lg"
      class="mt-2 w-full max-w-sm origin-left sm:col-span-2"
    >
      <span data-submit-label>{t("contact.form.submit")}</span>
      <span data-submitting-label hidden>{t("contact.form.submitting")}</span>
    </Button>
  </fieldset>

  <Button
    variant="outline"
    href={whatsappUrl}
    class="mt-4 max-[400px]:w-full max-[400px]:max-w-sm"
    >{t("services.cta.whatsapp")}</Button
  >

  {
    /* One live region, always rendered: only its text changes. It closes
      the form, in a slot tall enough for two lines, so nothing moves. */
  }
  <p class="status" role="status" data-status></p>
</form>

<style>
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }
  .group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .group > :global(label) span {
    color: var(--tx-muted);
  }

  /* Error text: red pulled toward the ink so it reads ≥ 4.5:1 at 12px in
     both modes; the field border carries the raw --red. The slot is
     reserved so an error never pushes the form down. */
  .error {
    min-height: 24px;
    margin: -4px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 20px;
    color: var(--error);
  }

  .status {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    min-height: 48px;
    margin: 16px 0 0;
    font-size: 16px;
    line-height: 24px;
    color: var(--tx);
    text-wrap: pretty;
  }
  /* One dither cell as the state marker: cycles through the ramp while
     sending, solid green on success, solid red on error. */
  .status:not(:empty)::before {
    content: "";
    flex: none;
    width: var(--cell);
    height: var(--cell);
    margin-top: 6px;
    background: var(--ink);
  }
  .status[data-state="sending"]::before {
    -webkit-mask: var(--dith-ramp) 0 0 / calc(var(--cell) * 4) var(--cell);
    mask: var(--dith-ramp) 0 0 / calc(var(--cell) * 4) var(--cell);
    animation: ramp 640ms steps(4, jump-none) infinite alternate;
  }
  .status[data-state="success"]::before {
    background: var(--green);
  }
  .status[data-state="error"]::before {
    background: var(--red);
  }
  @keyframes ramp {
    to {
      -webkit-mask-position: calc(var(--cell) * -3) 0;
      mask-position: calc(var(--cell) * -3) 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status[data-state="sending"]::before {
      animation: none;
    }
  }
</style>

<script
  is:inline
  define:vars={{
    required: t("contact.form.required"),
    invalidEmail: t("contact.form.invalidEmail"),
    tooShort: t("contact.form.tooShort"),
    sending: t("contact.form.submitting"),
    success: t("contact.form.success"),
    failure: t("contact.form.error"),
  }}
>
  function wireContactForm() {
    const form = document.getElementById("contact-form");
    if (!form || form.dataset.wired === "1") return;
    form.dataset.wired = "1";

    const fieldset = form.querySelector("fieldset");
    const submitLabel = form.querySelector("[data-submit-label]");
    const submittingLabel = form.querySelector("[data-submitting-label]");
    const status = form.querySelector("[data-status]");

    const subjectField = form.querySelector('[name="subject"]');
    const presetSubject = new URLSearchParams(location.search).get("subject");
    if (subjectField && presetSubject && !subjectField.value) {
      subjectField.value = presetSubject;
    }

    const checks = {
      name: (v) => (v ? "" : required),
      email: (v) =>
        !v
          ? required
          : /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)
            ? ""
            : invalidEmail,
      message: (v) => (!v ? required : v.length < 10 ? tooShort : ""),
    };

    function setError(name, msg) {
      form.querySelector(`[data-error-for="${name}"]`).textContent = msg;
      form
        .querySelector(`[name="${name}"]`)
        .setAttribute("aria-invalid", msg ? "true" : "false");
    }

    function setStatus(state, text) {
      status.dataset.state = state;
      status.textContent = text;
    }

    // Once a field is flagged, clear the error as soon as it is fixed.
    form.addEventListener("input", (e) => {
      const name = e.target.name;
      if (!checks[name] || e.target.getAttribute("aria-invalid") !== "true")
        return;
      if (!checks[name](e.target.value.trim())) setError(name, "");
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (fieldset.disabled) return;

      const payload = Object.fromEntries(new FormData(form));
      payload.lang = form.dataset.lang || "es";

      let firstInvalid = null;
      for (const name of Object.keys(checks)) {
        const msg = checks[name]((payload[name] || "").trim());
        setError(name, msg);
        if (msg && !firstInvalid) firstInvalid = form.elements[name];
      }
      if (firstInvalid) {
        setStatus("", "");
        firstInvalid.focus();
        return;
      }

      const focused = document.activeElement;
      fieldset.disabled = true;
      form.setAttribute("aria-busy", "true");
      submitLabel.hidden = true;
      submittingLabel.hidden = false;
      setStatus("sending", sending);

      let ok = false;
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const body = await res.json().catch(() => ({ ok: false }));
        ok = res.ok && body.ok;
      } catch {
        ok = false;
      }

      fieldset.disabled = false;
      form.removeAttribute("aria-busy");
      submitLabel.hidden = false;
      submittingLabel.hidden = true;
      if (ok) form.reset();
      setStatus(ok ? "success" : "error", ok ? success : failure);
      // Restore focus only when disabling the fieldset left it on <body>.
      if (
        document.activeElement === document.body &&
        focused instanceof HTMLElement &&
        fieldset.contains(focused)
      ) {
        focused.focus({ preventScroll: true });
      }
    });
  }

  wireContactForm();
  document.addEventListener("astro:page-load", wireContactForm);
</script>
