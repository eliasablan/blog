---
import type { Lang } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { cvUrl } from "@/i18n/cv";
import { whatsappUrl } from "@/lib/contact";
import Link from "@/components/Link.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const links = [
  { href: `/${lang}/rss.xml`, label: "RSS" },
  { href: "https://github.com/eliasablan", label: "GitHub" },
  { href: "https://www.linkedin.com/in/eliasablan", label: "LinkedIn" },
  { href: whatsappUrl, label: "WhatsApp" },
  { href: "mailto:eliasablan93@gmail.com", label: "Email" },
  { href: cvUrl(lang), label: t("footer.cv") },
];
---

<footer
  class="mx-auto w-full max-w-170 px-8 pt-16 pb-12 [view-transition-name:site-footer] max-[600px]:px-5 max-[600px]:pb-8"
>
  <div class="rule-dots" aria-hidden="true"></div>
  <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
    {links.map((link) => <Link href={link.href}>{link.label}</Link>)}
  </div>
  <p
    class="dith-bar mt-8 mb-0 h-[calc(var(--cell)*3)] gap-3 pl-3 font-mono text-[11px] font-bold tracking-[0.08em] whitespace-nowrap uppercase [--dith-w:calc(var(--px)*12)]"
  >
    © {year} Elias Ablan · Caracas
    <span class="dith ml-auto" aria-hidden="true"></span>
  </p>
</footer>
