---
import IconLanguage from "@tabler/icons/outline/language.svg";
import type { Lang } from "@/i18n/ui";
import { useTranslations, altLangUrl } from "@/i18n/utils";

interface Props {
  lang: Lang;
  /** Optional explicit URL to switch to (used by entry pages with translationKey). */
  altUrl?: string;
  /** When false, render disabled (no translation in target lang). */
  available?: boolean;
}

const { lang, altUrl, available = true } = Astro.props;
const t = useTranslations(lang);
const target: Lang = lang === "es" ? "en" : "es";
const href = altUrl ?? altLangUrl(Astro.url, target);
const label = useTranslations(target)("lang.switch");
---

{
  available ? (
    <a
      href={href}
      class="ctl"
      aria-label={label}
      title={label}
      lang={target}
      hreflang={target}
    >
      <IconLanguage class="block size-4" aria-hidden="true" />
    </a>
  ) : (
    <span class="ctl" aria-disabled="true" title={t("lang.notAvailable")}>
      <IconLanguage class="block size-4" aria-hidden="true" />
    </span>
  )
}
