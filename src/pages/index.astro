---
import { detectLang } from "@/i18n/detect";
import { languages } from "@/i18n/utils";
import type { Lang } from "@/i18n/ui";

export const prerender = false;

const supported = Object.keys(languages) as Lang[];

const target = detectLang(
  Astro.cookies.get("preferred-lang")?.value,
  Astro.request.headers.get("accept-language"),
  supported,
);

Astro.cookies.set("preferred-lang", target, {
  path: "/",
  maxAge: 60 * 60 * 24 * 365,
  sameSite: "lax",
});

return Astro.redirect(`/${target}/`);
---
