---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/starwind/Button.astro";
import Link from "@/components/Link.astro";
import { sectionPath } from "@/i18n/routes";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

// Resolve the locale from the URL that failed, rather than the build-time /404.
export const prerender = false;
Astro.response.status = 404;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t("notFound.title")} — Elías Ablán`}
  description={t("notFound.description")}
  lang={lang}
  altLangHref={null}
>
  <section
    class="mx-auto flex min-h-[58vh] max-w-170 flex-col justify-center px-8 pt-16 pb-8 font-mono text-foreground max-[600px]:px-5"
  >
    <div class="flex items-start justify-between gap-6">
      <p
        class="boxhead m-0 grid-cols-[auto_1fr] text-xs font-bold tracking-[0.08em] uppercase"
      >
        <span class="font-normal" aria-hidden="true">//</span>
        <span class="box-fill">{t("notFound.eyebrow")}</span>
      </p>
      <div class="checker max-[600px]:hidden" aria-hidden="true"></div>
    </div>

    <h1
      class="mt-9 mb-0 font-pixel text-[clamp(26px,3.5vw,42px)] leading-[1.12] font-bold tracking-[0.01em] text-balance uppercase"
    >
      {t("notFound.heading")}
    </h1>
    <p
      class="mt-5 mb-0 max-w-[34em] font-serif text-lg leading-[1.7] text-tx-secondary"
    >
      {t("notFound.body")}
    </p>

    <div class="rule-dots mt-10" aria-hidden="true"></div>

    <div class="mt-8 flex flex-col items-start gap-5">
      <Button href={`/${lang}/`} size="lg" class="w-full">
        {t("notFound.home")}
      </Button>
      <Link href={sectionPath(lang, "blog")}>{t("notFound.blog")} →</Link>
    </div>
  </section>
</BaseLayout>
