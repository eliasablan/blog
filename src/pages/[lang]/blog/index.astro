---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import ThemesSection from "@/components/ThemesSection.astro";
import SectionHead from "@/components/SectionHead.astro";
import EmptyState from "@/components/EmptyState.astro";
import { useTranslations, filterByLang, type Lang } from "@/i18n/utils";
import { isPublished, sortPostsByRecent } from "@/lib/content";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const posts = filterByLang(await getCollection("blog"), lang)
  .filter(isPublished)
  .sort(sortPostsByRecent);
---

<BaseLayout
  title={`${t("blog.title")} — Elías Ablán`}
  description={t("blog.intro")}
>
  <div
    class="mx-auto max-w-170 px-8 pt-16 pb-24 max-[600px]:px-5 max-[600px]:pt-10 max-[600px]:pb-16"
  >
    <header>
      <SectionHead as="h1">{t("blog.title")}</SectionHead>
      <p
        class="mt-9 mb-0 font-pixel text-[clamp(26px,3.5vw,42px)] leading-[1.12] font-bold tracking-[0.01em] text-balance"
      >
        {t("blog.intro")}
      </p>
    </header>

    <div class="mt-12">
      <ThemesSection lang={lang} />
    </div>

    <section class="mt-16">
      <SectionHead aside={String(posts.length).padStart(2, "0")} class="mb-6">
        {t("tags.articles")}
      </SectionHead>
      {
        posts.length === 0 ? (
          <EmptyState>{t("blog.empty")}</EmptyState>
        ) : (
          <PostList posts={posts} lang={lang} />
        )
      }
    </section>
  </div>
</BaseLayout>
