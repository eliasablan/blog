---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/starwind/Button.astro";
import {
  useTranslations,
  splitEntryId,
  getTranslatedEntry,
  type Lang,
} from "@/i18n/utils";
import { sectionSlugs, sectionPath, entryPath } from "@/i18n/routes";
import { tagLabels, tagPath } from "@/i18n/tags";
import { kindLabelsSingular } from "@/i18n/kinds";
import { isPublished } from "@/lib/content";

export async function getStaticPaths() {
  const projects = (await getCollection("portfolio")).filter(isPublished);
  return projects.map((project) => {
    const { lang, slug } = splitEntryId(project.id);
    return {
      params: { lang, projectsSlug: sectionSlugs[lang].projects, slug },
      props: { project },
    };
  });
}

const { project } = Astro.props as { project: CollectionEntry<"portfolio"> };
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { Content } = await render(project);
const key = project.data.translationKey;

const targetLang: Lang = lang === "en" ? "es" : "en";
const translated = await getTranslatedEntry("portfolio", project, targetLang);
const altUrl = translated
  ? entryPath(targetLang, "projects", splitEntryId(translated.id).slug)
  : null;

const contactHref = `/${lang}/#contact`;
const cta =
  project.data.kind === "client-work"
    ? {
        title: t("projects.cta.clientWork.title"),
        body: t("projects.cta.clientWork.body"),
        href: contactHref,
      }
    : project.data.kind === "solution"
      ? {
          title: t("projects.cta.solution.title"),
          body: t("projects.cta.solution.body"),
          href: `/${lang}/?${new URLSearchParams({
            subject: `${kindLabelsSingular.solution[lang]}: ${project.data.title}`,
          })}#contact`,
        }
      : null;
---

<BaseLayout
  title={`${project.data.title} — Elías Ablán`}
  description={project.data.description}
  altLangHref={altUrl}
>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <a
      href={sectionPath(lang, "projects")}
      class="text-sm text-muted-foreground hover:text-foreground"
    >
      {t("projects.back")}
    </a>

    <header class="mt-6 space-y-4">
      <div class="flex items-baseline justify-between gap-3">
        <h1
          class="text-4xl font-bold tracking-tight"
          transition:name={`project-${key}-title`}
        >
          {project.data.title}
        </h1>
        <span
          class="text-sm text-muted-foreground"
          transition:name={`project-${key}-year`}
        >
          {project.data.year}
        </span>
      </div>
      <p class="text-lg text-muted-foreground">
        <span transition:name={`project-${key}-description`}
          >{project.data.description}</span
        >
      </p>
      {
        project.data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2 pt-2">
            {project.data.tags.map((tag) => (
              <li>
                <a
                  href={tagPath(lang, tag)}
                  class="inline-block rounded-full border border-border bg-muted px-2.5 py-1 text-xs tracking-wider text-muted-foreground capitalize no-underline hover:opacity-80"
                >
                  {tagLabels[tag][lang]}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      {
        (project.data.demo || project.data.repo) && (
          <div class="flex flex-wrap gap-3 pt-2">
            {project.data.demo && (
              <Button href={project.data.demo} variant="primary" size="sm">
                {t("projects.demo")}
              </Button>
            )}
            {project.data.repo && (
              <Button href={project.data.repo} variant="outline" size="sm">
                {t("projects.repo")}
              </Button>
            )}
          </div>
        )
      }
    </header>

    <div class="mt-8 w-full overflow-hidden rounded-lg bg-muted">
      <Image
        src={project.data.cover}
        alt={project.data.coverAlt ?? project.data.title}
        widths={[600, 1200]}
        sizes="(max-width: 768px) 100vw, 800px"
        class="block h-auto w-full"
        transition:name={`project-${key}-cover`}
      />
    </div>

    <div class="prose mt-10 max-w-none prose-neutral dark:prose-invert">
      <Content />
    </div>

    {
      cta && (
        <aside class="mt-12 rounded-lg border border-border bg-muted p-6">
          <h2 class="text-xl font-semibold tracking-tight">{cta.title}</h2>
          <p class="mt-2 text-muted-foreground">{cta.body}</p>
          <Button href={cta.href} variant="primary" size="sm" class="mt-4">
            {t("projects.cta.button")}
          </Button>
        </aside>
      )
    }
  </article>
</BaseLayout>
