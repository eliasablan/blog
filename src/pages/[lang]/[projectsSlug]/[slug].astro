---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/starwind/Button.astro";
import Link from "@/components/Link.astro";
import ProjectSectionHeading from "@/components/ProjectSectionHeading.astro";
import {
  useTranslations,
  splitEntryId,
  getTranslatedEntry,
  type Lang,
} from "@/i18n/utils";
import { sectionSlugs, sectionPath, entryPath } from "@/i18n/routes";
import { tagLabels, tagPath } from "@/i18n/tags";
import { kindLabelsSingular } from "@/i18n/kinds";
import { isPublished } from "@/lib/content";

export async function getStaticPaths() {
  const projects = (await getCollection("portfolio")).filter(isPublished);
  return projects.map((project) => {
    const { lang, slug } = splitEntryId(project.id);
    return {
      params: { lang, projectsSlug: sectionSlugs[lang].projects, slug },
      props: { project },
    };
  });
}

const { project } = Astro.props as { project: CollectionEntry<"portfolio"> };
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { Content } = await render(project);
const key = project.data.translationKey;
const { kind, demo, repo, tags } = project.data;

const targetLang: Lang = lang === "en" ? "es" : "en";
const translated = await getTranslatedEntry("portfolio", project, targetLang);
const altUrl = translated
  ? entryPath(targetLang, "projects", splitEntryId(translated.id).slug)
  : null;

// The cover's title bar names where the Project lives.
const coverLabel = demo ? new URL(demo).hostname : Astro.params.slug;

const contactHref = `/${lang}/#contact`;
const cta =
  kind === "client-work"
    ? {
        title: t("projects.cta.clientWork.title"),
        body: t("projects.cta.clientWork.body"),
        href: contactHref,
      }
    : kind === "solution"
      ? {
          title: t("projects.cta.solution.title"),
          body: t("projects.cta.solution.body"),
          href: `/${lang}/?${new URLSearchParams({
            subject: `${kindLabelsSingular.solution[lang]}: ${project.data.title}`,
          })}#contact`,
        }
      : null;
---

<BaseLayout
  title={`${project.data.title} — Elías Ablán`}
  description={project.data.description}
  altLangHref={altUrl}
>
  <article
    class="mx-auto max-w-170 px-8 pt-16 pb-24 max-[600px]:px-5 max-[600px]:pt-10 max-[600px]:pb-16"
  >
    <Link href={sectionPath(lang, "projects")}>{t("projects.back")}</Link>

    <header class="mt-8">
      <div
        class="boxhead grid-cols-[auto_1fr_auto] font-mono text-xs font-bold tracking-[0.08em] uppercase"
      >
        <span class="font-normal" aria-hidden="true">//</span>
        <p class="box-fill m-0">{kindLabelsSingular[kind][lang]}</p>
        <span class="font-normal" transition:name={`project-${key}-year`}
          >{project.data.year}</span
        >
      </div>

      <h1
        class="mt-9 mb-0 font-serif text-[clamp(36px,5vw,52px)] leading-[1.08] font-semibold tracking-[-0.018em] text-balance"
        transition:name={`project-${key}-title`}
      >
        {project.data.title}
      </h1>
      <p
        class="mt-4.5 mb-0 text-[22px] leading-[1.4] text-pretty text-tx-secondary italic max-[600px]:text-xl"
      >
        <span transition:name={`project-${key}-description`}
          >{project.data.description}</span
        >
      </p>

      {
        tags.length > 0 && (
          <p class="mt-6 mb-0 flex flex-wrap items-baseline gap-x-2 gap-y-1 font-mono text-xs text-tx-muted">
            <span aria-hidden="true">//</span>
            {tags.map((tag, i) => (
              <span class="inline-flex items-baseline gap-x-2">
                <Link href={tagPath(lang, tag)}>{tagLabels[tag][lang]}</Link>
                {i < tags.length - 1 && <span aria-hidden="true">·</span>}
              </span>
            ))}
          </p>
        )
      }

      {
        (demo || repo) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {demo && <Button href={demo}>{t("projects.demo")}</Button>}
            {repo && (
              <Button href={repo} variant="outline">
                {t("projects.repo")}
              </Button>
            )}
          </div>
        )
      }
    </header>

    <figure class="m-0 mt-12 border border-ink">
      <div
        class="dith-bar h-[calc(var(--cell)*2)] pl-3 font-mono text-[11px] font-bold tracking-[0.08em] [--dith-w:calc(var(--px)*12)]"
        aria-hidden="true"
      >
        <span class="min-w-0 truncate">//{coverLabel}</span>
        <span class="dith ml-auto"></span>
      </div>
      <Image
        src={project.data.cover}
        alt={project.data.coverAlt ?? project.data.title}
        widths={[640, 1280]}
        sizes="(max-width: 680px) 100vw, 616px"
        class="block h-auto w-full"
        transition:name={`project-${key}-cover`}
      />
    </figure>

    <div class="project-body mt-12">
      <Content components={{ h2: ProjectSectionHeading }} />
    </div>

    {
      kind === "client-work" && cta && (
        <aside class="mt-16">
          <div class="rule-dots" aria-hidden="true" />
          <div class="mt-8 flex items-start justify-between gap-6">
            <div>
              <h2 class="m-0 font-serif text-[32px] leading-[1.2] font-semibold tracking-[-0.012em] text-balance before:mr-3 before:font-normal before:opacity-85 before:content-['§']">
                {cta.title}
              </h2>
              <p class="mt-3 mb-0 text-lg text-pretty text-tx-secondary">
                {cta.body}
              </p>
              <Button href={cta.href} class="mt-6">
                {t("projects.cta.button")}
              </Button>
            </div>
            <div class="checker max-[600px]:hidden" aria-hidden="true" />
          </div>
        </aside>
      )
    }

    {
      kind === "solution" && cta && (
        <aside class="offer mt-16">
          <div class="offer-in p-8 max-[600px]:p-5">
            <p
              class="m-0 font-mono text-xs tracking-[0.08em] uppercase opacity-70"
              aria-hidden="true"
            >
              //{kindLabelsSingular.solution[lang]}
            </p>
            <h2 class="mt-4 mb-0 font-pixel text-[clamp(24px,3.5vw,32px)] leading-[1.12] font-bold tracking-[0.01em] text-balance">
              {cta.title}
            </h2>
            <p class="offer-body mt-3 mb-0 text-lg text-pretty">{cta.body}</p>
            <Button href={cta.href} size="lg" class="mt-6">
              {t("projects.cta.button")}
            </Button>
          </div>
        </aside>
      )
    }

    {
      kind === "side-project" && (
        <footer class="mt-16">
          <div class="flex flex-wrap items-center gap-3">
            {demo && <Button href={demo}>{t("projects.demo")}</Button>}
            {repo && (
              <Button href={repo} variant="outline">
                {t("projects.repo")}
              </Button>
            )}
            <Link href={sectionPath(lang, "projects")} class="ml-auto">
              {t("projects.back")}
            </Link>
          </div>
        </footer>
      )
    }
  </article>
</BaseLayout>

<style>
  /* Solution offer: an ink panel. The inner box swaps ink and paper, so the
     primitives inside it (the .dith-bar CTA, its .dith, the focus ring)
     draw in paper on ink without new variants. */
  .offer {
    --ink-x: var(--ink);
    --paper-x: var(--paper);
    background: var(--ink);
    transition: background-color 0.25s ease;
  }
  .offer-in {
    --ink: var(--paper-x);
    --paper: var(--ink-x);
    color: var(--ink);
  }
  .offer-body {
    color: color-mix(in srgb, var(--ink) 80%, var(--paper));
  }
</style>

<style is:global>
  /* Rendered MDX gets no scope attribute, so these rules are global, keyed
     on .project-body. Case-study sections (each h2 and what follows it)
     hang off a 1px ink rule, like the Service entries. */
  .project-body {
    counter-reset: case;
  }
  .project-body > * {
    margin: 0;
  }
  .project-body > * + * {
    margin-top: 24px;
  }
  .project-body > * + h2 {
    margin-top: 48px;
  }
  .project-body > h2 ~ :not(h2) {
    margin-top: 0;
    padding: 20px 0 0 20px;
    border-left: 1px solid var(--ink);
    text-wrap: pretty;
  }
  .project-body > h2 ~ :not(h2):is(:last-child, :has(+ h2)) {
    padding-bottom: 20px;
  }
  .project-body strong {
    font-weight: 600;
  }
  .project-body ul,
  .project-body ol {
    padding-left: 1.4em;
    list-style: disc;
  }
  .project-body ol {
    list-style: decimal;
  }
  .project-body > h2 ~ :is(ul, ol) {
    padding-left: calc(20px + 1.4em);
  }
  .project-body li + li {
    margin-top: 8px;
  }
  .project-body img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--ink);
  }
  @media (max-width: 600px) {
    .project-body > h2 ~ :not(h2) {
      padding-left: 16px;
    }
    .project-body > h2 ~ :is(ul, ol) {
      padding-left: calc(16px + 1.4em);
    }
  }
</style>
