---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHead from "@/components/SectionHead.astro";
import EmptyState from "@/components/EmptyState.astro";
import Link from "@/components/Link.astro";
import { useTranslations, filterByLang, type Lang } from "@/i18n/utils";
import { sectionPath } from "@/i18n/routes";
import { tagSlugs, tagLabels, type TagSlug } from "@/i18n/tags";
import {
  isPublished,
  sortPostsByRecent,
  sortProjectsByRecent,
} from "@/lib/content";

// Every Topic gets a page, even with nothing filed under it yet: the
// Topics list links all of them.
export function getStaticPaths() {
  return (["en", "es"] as const).flatMap((lang) =>
    tagSlugs.map((tag) => ({ params: { lang, tag }, props: { tag } })),
  );
}

const lang = Astro.params.lang as Lang;
const { tag } = Astro.props as { tag: TagSlug };
const t = useTranslations(lang);
const label = tagLabels[tag][lang];
const pad = (n: number) => String(n).padStart(2, "0");

const posts = filterByLang(await getCollection("blog"), lang)
  .filter((p) => isPublished(p) && p.data.tags.includes(tag))
  .sort(sortPostsByRecent);

const projects = filterByLang(await getCollection("portfolio"), lang)
  .filter((p) => isPublished(p) && p.data.tags.includes(tag))
  .sort(sortProjectsByRecent);

const isEmpty = posts.length === 0 && projects.length === 0;
---

<BaseLayout title={`${label} — Elías Ablán`} description={label}>
  <div
    class="mx-auto max-w-170 px-8 pt-16 pb-24 max-[600px]:px-5 max-[600px]:pt-10 max-[600px]:pb-16"
  >
    <header>
      <SectionHead as="p" aside={pad(posts.length + projects.length)}>
        {t("tags.eyebrow")}
      </SectionHead>
      <h1
        class="mt-9 mb-0 font-pixel text-[clamp(26px,3.5vw,42px)] leading-[1.12] font-bold tracking-[0.01em] text-balance"
      >
        {label}
      </h1>
    </header>

    {
      isEmpty && (
        <div class="mt-12">
          <EmptyState>{t("tags.empty")}</EmptyState>
        </div>
      )
    }

    {
      posts.length > 0 && (
        <section class="mt-12">
          <SectionHead aside={pad(posts.length)} class="mb-6">
            {t("tags.articles")}
          </SectionHead>
          <PostList posts={posts} lang={lang} />
        </section>
      )
    }

    {
      projects.length > 0 && (
        <section class="mt-16">
          <SectionHead aside={pad(projects.length)} class="mb-6">
            {t("tags.projects")}
          </SectionHead>
          <ul class="m-0 flex list-none flex-col gap-6 p-0">
            {projects.map((project) => (
              <li>
                <ProjectCard project={project} lang={lang} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="mt-12 mb-0">
      <Link href={`${sectionPath(lang, "blog")}#topics`}>{t("blog.back")}</Link>
    </p>
  </div>
</BaseLayout>
