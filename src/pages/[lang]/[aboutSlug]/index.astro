---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Lang } from "@/i18n/ui";
import { sectionSlugs } from "@/i18n/routes";
import { cvUrl } from "@/i18n/cv";

export function getStaticPaths() {
  return (["en", "es"] as const).map((lang) => ({
    params: { lang, aboutSlug: sectionSlugs[lang].about },
  }));
}

const lang = Astro.params.lang as Lang;

// Page copy lives here (single use). Each entry keeps its locales together.
const copy = {
  title: {
    es: "Sobre mí — Elías Ablán",
    en: "About — Elías Ablán",
  },
  description: {
    es: "Trayectoria de Elías Ablán, desarrollador full-stack en Caracas. Experiencia en desarrollo web, NetSuite e infraestructura de TI.",
    en: "Work history of Elías Ablán, a full-stack developer in Caracas with experience in web development, NetSuite, and IT infrastructure.",
  },
  eyebrow: { es: "Sobre mí", en: "About" },
  place: { es: "Caracas, Venezuela", en: "Caracas, Venezuela" },
  heading: { es: "Elías Ablán", en: "Elías Ablán" },
  intro: {
    es: [
      "Empecé haciendo páginas en WordPress con un amigo. De aquel primer sitio recuerdo que logramos publicarlo, aunque hoy no sabría decir cómo configuramos el dominio. Vortex Robotics fue la primera empresa que me contrató como desarrollador web.",
      "Mi segundo empleo fue en Kavak, donde trabajé cuatro años como desarrollador de NetSuite. Fue la etapa en la que más crecí como desarrollador. Ahí aprendí a trabajar en equipo sobre software que ya se usaba en producción.",
      "Después de Kavak empecé a trabajar por mi cuenta. Al desplegar mis propios proyectos, fui aprendiendo a administrar servidores Linux, usar Docker y configurar DNS. También me metí más en redes y en los protocolos que intervienen cuando una aplicación se comunica con otros sistemas.",
    ],
    en: [
      "I started out building WordPress sites with a friend. I remember getting our first site online, though I couldn’t tell you now how we set up the domain. Vortex Robotics was the first company to hire me as a web developer.",
      "Kavak was my second employer. I spent four years there as a NetSuite developer, and it’s where I grew the most as a developer. I learned how a team ships changes to software people already rely on.",
      "After Kavak, I started working independently. Deploying my own projects got me into running Linux servers, using Docker, and configuring DNS. I also went deeper into networking and the protocols applications use to communicate with other systems.",
    ],
  },
} as const;

const experience = [
  {
    title: {
      es: "Desarrollo web full-stack",
      en: "Full-stack web development",
    },
    org: { es: "Vortex Robotics", en: "Vortex Robotics" },
    dates: { es: "ago. 2017–jul. 2018", en: "Aug 2017–Jul 2018" },
    body: {
      es: "Construí aplicaciones web y tiendas en línea con Django, CodeIgniter y WordPress. También diseñé y optimicé esquemas de bases de datos en MySQL y PostgreSQL.",
      en: "I built web applications and online stores with Django, CodeIgniter, and WordPress. I also designed and optimized database schemas in MySQL and PostgreSQL.",
    },
  },
  {
    title: { es: "Desarrollador de NetSuite", en: "NetSuite Developer" },
    org: { es: "Kavak", en: "Kavak" },
    dates: { es: "dic. 2018–dic. 2022", en: "Dec 2018–Dec 2022" },
    body: {
      es: "Creé y mantuve scripts User Event, Client, Scheduled, Portlet y RESTlet con SuiteScript. Integré NetSuite con otros sistemas y administré roles y permisos. También coordiné el trabajo del equipo de desarrollo y revisé código.",
      en: "I built and maintained User Event, Client, Scheduled, Portlet, and RESTlet scripts in SuiteScript. I integrated NetSuite with other systems and managed roles and permissions. I also coordinated the development team’s work and reviewed code.",
    },
  },
  {
    title: {
      es: "Desarrollo web independiente",
      en: "Freelance web development",
    },
    org: null,
    dates: { es: "desde dic. 2022", en: "Since Dec 2022" },
    body: {
      es: "Para un fabricante de tanques construí un catálogo editable y un formulario de cotización. Para esa misma empresa renové la red de oficina con Windows Server y configuré el acceso remoto por VPN. Mi proyecto más reciente es Autosfront, una demo para negocios de carros a consignación en Caracas.",
      en: "I built an editable catalog and quote request form for a tank manufacturer. For the same company, I rebuilt the office network with Windows Server and set up remote access over a VPN. My latest project is Autosfront, a demo for used-car consignment businesses in Caracas.",
    },
  },
];

const skills = [
  {
    label: { es: "Web", en: "Web" },
    items: [
      "Next.js",
      "React",
      "TypeScript",
      "Tailwind",
      "Astro",
      "Hono",
      "tRPC",
      "PostgreSQL",
      "Drizzle",
      "Supabase",
      "Sanity",
      "WebSockets",
      "SEO",
    ],
  },
  {
    label: { es: "Infraestructura", en: "Infrastructure" },
    items: [
      "Linux",
      "Windows Server",
      { es: "Redes", en: "Networks" },
      { es: "Contenedores", en: "Containers" },
      "Self-hosting",
      "Cloudflare",
    ],
  },
  {
    label: { es: "Sistemas de negocio", en: "Business systems" },
    items: [
      "NetSuite",
      "SuiteScript",
      { es: "Integraciones", en: "Integrations" },
      { es: "Automatizaciones", en: "Automations" },
      "n8n",
    ],
  },
  {
    label: { es: "Flujo de trabajo con IA", en: "AI-assisted workflow" },
    items: [
      { es: "Desarrollo asistido por IA", en: "AI-assisted development" },
      "OpenAI API",
      "Claude",
      "Codex",
      "MCPs",
      "Skills",
      "Hermes",
    ],
  },
];

// Proper nouns (Linux, Astro...) are plain strings; the rest carry both locales.
const itemText = (item: string | { es: string; en: string }) =>
  typeof item === "string" ? item : item[lang];

const looking = {
  label: { es: "Busco", en: "Looking for" },
  lead: {
    es: "Trabajo remoto primero, abierto a mudarme.",
    en: "Remote first, open to relocation.",
  },
  order: { es: "En orden de preferencia", en: "In order of preference" },
  // width is the share of the row each bar fills: longer bar, higher priority.
  roles: [
    {
      label: { es: "Desarrollo full-stack", en: "Full-stack developer" },
      width: 100,
    },
    {
      label: { es: "Roles cercanos a la IA", en: "AI-adjacent roles" },
      width: 90,
    },
    { label: { es: "NetSuite", en: "NetSuite" }, width: 62 },
  ],
};

const labels = {
  experience: { es: "Experiencia", en: "Experience" },
  stack: { es: "Stack", en: "Stack" },
  links: { es: "CV y enlaces", en: "CV & links" },
  cv: { es: "Descargar CV (PDF)", en: "Download CV (PDF)" },
};

const boxhead =
  "boxhead mt-14 mb-6 grid-cols-[auto_1fr] font-mono text-xs font-bold tracking-[0.08em] uppercase";
---

<BaseLayout title={copy.title[lang]} description={copy.description[lang]}>
  <article
    class="mx-auto max-w-170 px-8 pt-14 pb-24 max-[600px]:px-5 max-[600px]:pt-10 max-[600px]:pb-16"
  >
    <div
      class="boxhead grid-cols-[auto_1fr_auto] font-mono text-xs font-bold tracking-[0.08em] text-foreground uppercase"
    >
      <span class="font-normal" aria-hidden="true">//</span>
      <p class="box-fill m-0 leading-[1.25]">{copy.eyebrow[lang]}</p>
      <span class="font-normal max-[600px]:hidden">{copy.place[lang]}</span>
    </div>

    <h1
      class="mt-9 mb-8 font-pixel text-[clamp(26px,3.5vw,42px)] leading-[1.12] font-bold tracking-[0.01em] text-balance text-foreground"
    >
      {copy.heading[lang]}
    </h1>

    <div class="flex flex-col gap-6 text-lg leading-[1.7] text-foreground">
      {copy.intro[lang].map((paragraph) => <p class="m-0">{paragraph}</p>)}
    </div>

    <div class="rule-dots mt-12" aria-hidden="true"></div>

    <section aria-labelledby="about-experience">
      <div class={boxhead}>
        <span class="font-normal" aria-hidden="true">//01</span>
        <h2 id="about-experience" class="box-fill m-0 text-xs font-bold">
          {labels.experience[lang]}
        </h2>
      </div>
      <ol class="timeline m-0 list-none p-0">
        {
          experience.map((job) => (
            <li class="relative pb-8 pl-6 last:pb-0">
              <p class="m-0 font-mono text-xs font-bold tracking-[0.06em] text-foreground uppercase">
                {job.dates[lang]}
              </p>
              <h3 class="mt-2 mb-0 font-serif text-[22px] leading-[1.3] font-semibold text-foreground">
                {job.title[lang]}
                {job.org && (
                  <span class="font-mono text-xs font-normal tracking-[0.06em] text-tx-muted uppercase">
                    {" "}
                    · {job.org[lang]}
                  </span>
                )}
              </h3>
              <p class="mt-1 mb-0 text-[17px] leading-[1.6] text-tx-secondary">
                {job.body[lang]}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="about-stack">
      <div class={boxhead}>
        <span class="font-normal" aria-hidden="true">//02</span>
        <h2 id="about-stack" class="box-fill m-0 text-xs font-bold">
          {labels.stack[lang]}
        </h2>
      </div>
      <dl class="m-0 flex flex-col gap-6">
        {
          skills.map((group) => (
            <div>
              <dt class="font-mono text-xs tracking-[0.12em] text-tx-secondary uppercase">
                //{group.label[lang]}
              </dt>
              <dd class="m-0 mt-1.5 font-mono text-sm leading-[2] text-foreground">
                {group.items.map((item, i) => (
                  <span class="inline-flex items-baseline whitespace-nowrap">
                    {itemText(item)}
                    {i < group.items.length - 1 && (
                      <span class="px-1 text-tx-muted" aria-hidden="true">
                        ·
                      </span>
                    )}
                  </span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="about-looking">
      <div class={boxhead}>
        <span class="font-normal" aria-hidden="true">//03</span>
        <h2 id="about-looking" class="box-fill m-0 text-xs font-bold">
          {looking.label[lang]}
        </h2>
      </div>
      <div class="flex items-start justify-between gap-6">
        <p class="m-0 text-lg leading-[1.7] text-foreground">
          {looking.lead[lang]}
        </p>
        <div class="checker" aria-hidden="true"></div>
      </div>
      <p
        class="mt-6 mb-3 font-mono text-xs tracking-[0.06em] text-tx-muted uppercase"
      >
        //{looking.order[lang]}
      </p>
      <ol class="m-0 flex list-none flex-col gap-3 p-0">
        {
          looking.roles.map((role, i) => (
            <li
              class="dith-bar h-[calc(var(--cell)*4)] pl-4 font-mono text-[12px] font-bold tracking-[0.06em] whitespace-nowrap uppercase"
              style={`width:${role.width}%`}
            >
              0{i + 1}&nbsp;&nbsp;{role.label[lang]}
              <span class="dith ml-auto" aria-hidden="true" />
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="about-links">
      <div class={boxhead}>
        <span class="font-normal" aria-hidden="true">//04</span>
        <h2 id="about-links" class="box-fill m-0 text-xs font-bold">
          {labels.links[lang]}
        </h2>
      </div>
      <a
        href={cvUrl(lang)}
        target="_blank"
        rel="noopener noreferrer"
        class="dith-bar h-[calc(var(--cell)*5)] gap-4 pl-6 font-mono text-[13px] font-bold tracking-[0.08em] whitespace-nowrap uppercase"
      >
        {labels.cv[lang]}
        <span class="ml-auto pr-1 opacity-60" aria-hidden="true">///</span>
        <span class="dith" aria-hidden="true"></span>
      </a>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          class="ctl px-4 tracking-[0.08em]"
          href="https://github.com/eliasablan"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
        <a
          class="ctl px-4 tracking-[0.08em]"
          href="https://www.linkedin.com/in/eliasablan"
          target="_blank"
          rel="noopener noreferrer">LinkedIn</a
        >
        <a
          class="ctl px-4 tracking-[0.08em]"
          href="mailto:eliasablan93@gmail.com">Email</a
        >
      </div>
    </section>

    <div class="rule-dots mt-14" aria-hidden="true"></div>
    <p
      class="mt-2.5 mb-0 font-mono text-xs tracking-[0.06em] text-foreground uppercase"
    >
      {copy.place[lang]}
    </p>
  </article>
</BaseLayout>

<style>
  .timeline {
    border-left: 1px dotted var(--ink);
  }
  .timeline > li::before {
    content: "";
    position: absolute;
    top: 0;
    left: -5px;
    width: 9px;
    height: 9px;
    background: var(--ink);
  }
</style>
